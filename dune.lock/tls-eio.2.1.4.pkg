(version 2.1.4)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml dune tls mirage-crypto-rng eio ptime)))

(source
 (fetch
  (url
   https://github.com/mirleft/ocaml-tls/releases/download/v2.1.4/tls-2.1.4.tbz)
  (checksum
   sha512=605fec98fcd9a31aea794f3ef4d8d40e739e634c228b5e7a016c9a4025f489d151cd9979d5804ce9680caf5bd16c21ca6e22dd91f9f7217f8b2ddb74b9c8cac3)))
